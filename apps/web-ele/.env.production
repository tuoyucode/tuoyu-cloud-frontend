VITE_BASE=/

# 接口地址
# 部署时由 Nginx 把 /api 转发到后端网关
VITE_GLOB_API_URL=/api

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true

# 后端客户端 ID（sys_client.client_id），默认对应种子数据中的 pc 客户端
VITE_APP_CLIENT_ID=e5cd7e4891bf95d1d19206ce24a7b32e
